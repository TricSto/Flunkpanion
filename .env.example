# Supabase-Zugangsdaten für den Live-/Server-Modus.
#
# 1. Diese Datei zu ".env" kopieren:  cp .env.example .env
# 2. Werte aus dem Supabase-Dashboard eintragen
#    (Project Settings → API → "Project URL" und "anon public" Key).
# 3. Dev-Server neu starten (npm run dev).
#
# Sind die Werte NICHT gesetzt, läuft die App weiter rein lokal (Offline-Modus) –
# alles funktioniert wie bisher, nur ohne Geräte-übergreifende Live-Updates.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
